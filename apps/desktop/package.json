{
  "name": "g9agent-desktop",
  "productName": "G9Agent",
  "version": "0.1.0",
  "private": true,
  "description": "Windows Electron shell for G9Agent.",
  "author": "AI9Stars",
  "homepage": "https://github.com/AI9Stars/G9Agent",
  "license": "AGPL-3.0-only",
  "desktopName": "g9agent-desktop",
  "main": "dist/main.js",
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "compile": "tsc -p tsconfig.json",
    "dev": "node scripts/build-runtime.mjs && tsc -p tsconfig.json && electron .",
    "pack": "node scripts/build-runtime.mjs && tsc -p tsconfig.json && electron-builder --config electron-builder.config.cjs --dir",
    "dist:win": "node scripts/check-windows-build-host.mjs && node scripts/build-runtime.mjs && tsc -p tsconfig.json && electron-builder --config electron-builder.config.cjs --win --publish never",
    "dist:win:x64": "node scripts/check-windows-build-host.mjs x64 && node scripts/build-runtime.mjs && tsc -p tsconfig.json && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "dist:win:arm64": "node scripts/check-windows-build-host.mjs arm64 && node scripts/build-runtime.mjs && tsc -p tsconfig.json && electron-builder --config electron-builder.config.cjs --win --arm64 --publish never",
    "dist:win:portable": "node scripts/build-runtime.mjs && tsc -p tsconfig.json && electron-builder --config electron-builder.config.cjs --win portable --publish never",
    "download-git-bash": "node scripts/download-git-bash.mjs",
    "download-node": "node scripts/download-node.mjs",
    "download-cua-driver": "node scripts/download-cua-driver.mjs",
    "download-playwright-browsers": "node scripts/download-playwright-browsers.mjs",
    "test": "node --test scripts/*.test.mjs scripts/*.spec.mjs"
  },
  "dependencies": {
    "@g9agent/config": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "cn.g9agent.desktop",
    "productName": "G9Agent",
    "executableName": "G9Agent",
    "artifactName": "G9Agent-${version}-${os}-${arch}.${ext}",
    "compression": "maximum",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      {
        "from": ".",
        "filter": [
          "dist/**/*",
          "package.json"
        ]
      }
    ],
    "asar": true,
    "electronFuses": {
      "enableNodeOptionsEnvironmentVariable": false
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "resources/python-runtime",
        "to": "python-runtime"
      },
      {
        "from": "resources/uninstall-data.cjs",
        "to": "uninstall-data.cjs"
      },
      {
        "from": "resources/node",
        "to": "node"
      },
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/build-metadata.json",
        "to": "build-metadata.json"
      },
      {
        "from": "resources/git",
        "to": "git",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      },
      {
        "from": ".runtime/app",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icons/icon.ico",
      "extraFiles": [
        {
          "from": "resources/G9Agent.VisualElementsManifest.xml",
          "to": "G9Agent.VisualElementsManifest.xml"
        }
      ],
      "legalTrademarks": "Copyright © OpenBMB",
      "target": [
        {
          "target": "nsis"
        }
      ],
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "guid": "08ed5a8d-9d33-5436-8d8c-6ce3ff9bc924",
      "differentialPackage": true,
      "artifactName": "G9Agent-${version}-${os}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "installerIcon": "resources/icons/installer-icon.ico",
      "uninstallerIcon": "resources/icons/installer-icon.ico",
      "include": "resources/installer.nsh",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "createDesktopShortcut": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "G9Agent-${version}-${os}-${arch}-portable.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/AI9Stars/G9Agent/releases/latest/download"
    }
  }
}
