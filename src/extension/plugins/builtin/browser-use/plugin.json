{
  "name": "browser-use",
  "version": "1.0.0",
  "description": "Browser automation powered by @playwright/mcp (Microsoft)",
  "skills": "skills",
  "mcpServers": {
    "browser-use": {
      "command": "__G9AGENT_NODE_EXECUTABLE__",
      "args": [
        "__G9AGENT_PLAYWRIGHT_MCP_ENTRYPOINT__",
        "--browser",
        "chromium",
        "--allow-unrestricted-file-access"
      ],
      "perSession": true
    }
  }
}
